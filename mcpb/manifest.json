{
  "manifest_version": "0.2",
  "name": "bumi-mcp",
  "version": "0.2.0",
  "description": "FastMCP 3.1.0 MCP for Noetix Bumi humanoid — hero specs, OSS links, fleet virtual-twin guidance, optional robot bridge",
  "author": { "name": "Sandra Schieder" },
  "server": {
    "type": "python",
    "entry_point": "src/bumi_mcp/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","python","-m","bumi_mcp"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "bumi_tool", "description": "bumi_tool" }
  ]
}
